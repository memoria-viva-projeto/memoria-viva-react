# Copie este arquivo para .env.local e preencha. O .env.local NÃO vai para o git (está no .gitignore).
# Nada aqui usa o prefixo VITE_: estes valores ficam só no servidor e nunca vão para o navegador.

# ---- Servidor da API (npm run api) ----
API_PORTA=3001
# Endereços que podem chamar a API pelo navegador (separados por vírgula).
CORS_ORIGENS=http://localhost:5173,http://localhost:4173
# Quantos dias a pessoa fica logada sem usar o site (cada uso renova o prazo).
SESSAO_DIAS=14

# ---- Fotos enviadas ----
# Onde eles ficam (pasta local ou S3) é escolhido na tabela "configuracao" do banco, não aqui.
# Armazenamento local: a pasta. Vazio = a pasta "armazenamento" do projeto.
# Nunca use uma pasta dentro de public/ (lá qualquer pessoa abriria os arquivos sem login).
ARQUIVOS_PASTA=
# Armazenamento S3 (armazenamento = s3 na tabela configuracao): as chaves de acesso ficam SÓ aqui, nunca no banco.
# Num servidor da AWS com papel (IAM role), deixe vazias: a biblioteca usa o papel da máquina.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- MySQL ----
DB_HOST=localhost
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=
DB_NOME=memoria_viva
# Banco só dos testes: é APAGADO e recriado a cada "npm test". Precisa terminar em _teste.
DB_NOME_TESTE=memoria_viva_teste
